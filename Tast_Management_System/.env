# Copy to .env and fill in. Never commit .env.

# SQL Server "sa" password: 8+ chars with upper, lower, digit and symbol. Do not use ';' (it breaks the connection string).
MSSQL_SA_PASSWORD="Test@123"
# Developer | Express | Standard | Enterprise (a paid edition needs a licence)
MSSQL_PID=Developer
DB_NAME=TaskManagementDb
# Host port for SQL tools (localhost only). Not 1433, so it doesn't clash with a local SQL Server.
SQL_PORT=14333

# JWT signing key, at least 32 characters. Generate one with:
#   $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY="v7iP5DHshtmakoLBxJdKpM9LNOxIVN1v5IX0RXSZfP0="

# Production | Development
ASPNETCORE_ENVIRONMENT=Production

# Login user (ASP.NET Core Identity v3 hash, never the plain password). Generate with README "Change the login".
AUTH_USER_EMAIL=admin@taskmanagement.local
AUTH_USER_PASSWORD_HASH=AQAAAAIAAYagAAAAECIXTO6e10P22MZ8ZHH7o93w0PPTlXX77y0GBFLcSvLtGrmu0WeErtcgUUmyVVO4XQ==
# true = the login above also works in Production. Safe only because the UI is bound to 127.0.0.1 (localhost).
AUTH_ALLOW_CONFIGURED_USERS=true

# Host port for the UI -> http://localhost:8080 (bound to 127.0.0.1 only)
UI_PORT=8080

# Leave empty: the UI calls /api on its own origin. Set only if the API lives on another domain.
VITE_API_BASE_URL=

# Image tag for task-management/* images
TAG=latest
