# Where the Vite dev server forwards /api requests: TaskManagement.Api's "https" launch profile.
# Use http://localhost:5008 if you run the API with the "http" profile instead.
API_PROXY_TARGET=https://localhost:7213

# Leave empty in development so requests go through the proxy above.
# Set to the API's absolute URL (e.g. https://api.example.com) for builds served elsewhere.
VITE_API_BASE_URL=
