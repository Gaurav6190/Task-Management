# Copy to .env.local to override.

# Where the Vite dev server proxies /api requests (TaskManagement.Api).
# "https" profile: https://localhost:7213   "http" profile: http://localhost:5008
VITE_API_PROXY_TARGET=https://localhost:7213

# Base URL the browser uses for API calls. Leave empty to use the dev proxy
# (same origin). Set it for a deployed build, e.g. https://api.example.com
# (that origin must then be listed in the API's Cors:AllowedOrigins).
VITE_API_BASE_URL=
